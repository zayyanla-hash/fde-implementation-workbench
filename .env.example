# Copy to .env (optional — the demo runs with zero credentials).
# Everything below is inert documentation; no live model or API keys are needed.
WORKBENCH_SCENARIO=vendor_payments_v1
WORKBENCH_RULES=fixtures/rules.json
WORKBENCH_AUDIT_DIR=./var/audit
WORKBENCH_PORT=8765
# Failure-injection knobs for deterministic retry demos (no network involved):
WORKBENCH_FLAKY_VENDOR_FAILS=1
WORKBENCH_DRY_RUN=false
